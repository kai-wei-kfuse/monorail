{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "像素记录",
  "version": "0.1.0",
  "identifier": "local.pixelrecord.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "像素记录",
        "width": 1000,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      },
      {
        "label": "quickbar",
        "title": "像素记录 · 快速记录",
        "width": 760,
        "height": 120,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "dragDropEnabled": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "quickbar"
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "记录、任务卡与时间回顾",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
