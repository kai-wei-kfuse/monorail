{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "单轨",
  "version": "../package.json",
  "identifier": "local.pixelrecord.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "单轨",
        "width": 1000,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      },
      {
        "label": "quickbar",
        "title": "单轨 · 快速记录",
        "width": 760,
        "height": 120,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "dragDropEnabled": false,
        "skipTaskbar": true
      },
      {
        "label": "mini",
        "title": "单轨 · 小窗口",
        "url": "mini.html",
        "create": false,
        "width": 520,
        "height": 110,
        "minWidth": 320,
        "minHeight": 110,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "dragDropEnabled": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "quickbar",
        "mini"
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "记录、任务卡与时间回顾",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRUM5MjRGNUZBNDQ1NjYKUldSbVJhUmZUNUxzbm9QcmNMRjJwY1JZdzdCU3krWFVvVHNaODdNbmJrNUFkSFl3bUd5K2VwcDAK",
      "windows": { "installMode": "passive" }
    },
    "privateUpdater": { "repository": "kai-wei-kfuse/monorail", "releaseTag": null }
  }
}
