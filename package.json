{
  "name": "pixel-record",
  "private": true,
  "version": "0.3.0-beta.2",
  "type": "module",
  "scripts": {
    "mcp": "node mcp/main.ts",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:check": "tsc --noEmit -p mcp/tsconfig.json",
    "mcp:smoke": "node --test --test-timeout=60000 mcp/compatibility.test.ts mcp/windowsLauncher.test.ts",
    "cli": "node cli/main.ts",
    "cli:build": "node scripts/build-mcp.mjs cli",
    "cli:smoke": "node --test --test-timeout=60000 cli/cli.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run mcp:check && npm run mcp:build && vite build",
    "build:verify": "tsc --noEmit && npm run mcp:check && npm run mcp:build && vite build --mode verify",
    "test": "node test-runner.mjs",
    "check": "tsc --noEmit && npm run mcp:check && eslint src client cli mcp && npm test && npm run mcp:build && npm run mcp:smoke && npm run cli:smoke",
    "tauri": "tauri",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/saira": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "misans": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
